# Database configuration (PostgreSQL - used for historical data analysis)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homeassistant
DB_USER=ml_agent
DB_PASSWORD=your_postgres_password_here

# Home Assistant configuration
HA_HOST=http://192.168.0.1:8123
HA_TOKEN=your_home_assistant_token_here

# Electricity pricing and tariffs
# All values are in EUR per kWh unless noted otherwise.
# GRID_FEES_EUR_PER_KWH is the single combined value for all grid transfer fees, taxes,
# and other costs between the raw spot price and the actual import price.
# Used by build_tariff_prices(), estimate_export_prices() / estimate_import_prices().
GRID_FEES_EUR_PER_KWH=0.06                # Combined grid fees: covers transfer, tax, VAT, adders, etc.
IMPORT_PRICE_FLOOR_EUR_PER_KWH=0.0        # Minimum import price for battery optimizer. Set >0 when contract has a fixing point + variable delta that prevents low spot prices from being realized. Only affects battery charge/discharge decisions, not EV/GSHP/Leaf scheduling.
PRICE_PEG_POINT_EUR_PER_KWH=0.0            # Fee-exclusive fixed energy price for the price-pegging contract.
PEGGING_SHARE=0.0                          # Fraction of consumption price-pegged: 0.0 = spot, 0.5 = 50%, 1.0 = fully pegged. Timing still follows the spot signal via kulutusvaikutus.
KULUTUSVAIKUTUS_STATE_FILE=state/kulutusvaikutus_state.json  # Runtime state: raw settled spot-price sum/count and latest included local day. The monthly mean is reset automatically each month and prevents daily prices being counted twice.
# Used only before Home Assistant publishes valid tomorrow prices. The feed is
# treated as a raw export/spot price; GRID_FEES_EUR_PER_KWH is added to imports.
NORDPOOL_PREDICTION_URL=https://raw.githubusercontent.com/vividfog/nordpool-predict-fi/main/deploy/prediction.json
NORDPOOL_PREDICTION_TIMEOUT_SECONDS=10
NORDPOOL_PREDICTION_CACHE_FILE=state/nordpool_prediction.json  # Cached feed response; refreshed after one hour.

# Battery optimization settings
# If BATTERY_CAPACITY_KWH is 0, the optimizer returns a no-op (idle) battery plan.
# The optimizer uses a profit-only approach: it charges from solar surplus first, discharges when
# current prices are higher than future prices, and only grid-charges when there is a clear price
# delta to exploit and expected PV surplus is not enough to fill the battery.
BATTERY_MIN_SOC_PCT=10.0                   # Minimum allowed State of Charge (%) during normal operation. Hard floor used by the optimizer.
BATTERY_MAX_SOC_PCT=90.0                   # Maximum allowed State of Charge (%) during normal operation.
BATTERY_RESERVE_SOC_PCT=10.0               # Emergency reserve SOC (%). Defaults to BATTERY_MIN_SOC_PCT in code if omitted. The actual floor is max(MIN, RESERVE).
BATTERY_CAPACITY_KWH=50.0                  # Total usable battery capacity in kWh. Set to 0 to disable battery simulation.
BATTERY_MAX_CHARGE_KW=10.0                 # Maximum charge power in kW (inverter / BMS limit).
BATTERY_MAX_DISCHARGE_KW=10.0              # Maximum discharge power in kW (inverter / BMS limit).
BATTERY_CHARGE_EFFICIENCY=0.95             # Charge conversion efficiency (0.0-1.0). Clamped to [0.01, 1.0] in code.
BATTERY_DISCHARGE_EFFICIENCY=0.95          # Discharge conversion efficiency (0.0-1.0). Clamped to [0.01, 1.0] in code.
BATTERY_ALLOW_EXPORT=true                  # When false, export is prohibited: the LP blocks solar and battery export and curtails excess solar.
BATTERY_ALLOW_EXPORT_ENTITY=input_boolean.battery_allow_export  # Home Assistant boolean switch that overrides BATTERY_ALLOW_EXPORT at runtime.
BATTERY_INITIAL_SOC_PCT=50                 # Fallback starting SOC (%) when sensor.be_soc is unavailable in Home Assistant.
BATTERY_GRID_CHARGE_MIN_MARGIN_EUR_PER_KWH=0.005  # Minimum price margin (EUR/kWh) to trigger near-term grid charging arbitrage. Set to 0.0 for aggressive local spreads, or 0.005 to avoid micro-cycling.
BATTERY_NET_METERING=true                  # When true, use cumulative energy meters to match quarterly average power instead of instantaneous load following. Prevents sun leak with net metering.
BATTERY_IDLE_SOLAR_CHARGE_MAX_EXPORT_PRICE=0.02 # During automatic idle, absorb live solar export below this EUR/kWh price.
BATTERY_RAMP_RATE_KW_PER_MIN=3.0          # Max battery power change rate (kW/min). 0=disabled. Prevents sudden power swings from net metering end-of-interval corrections.
BATTERY_FOLLOW_MAX_KW=10.0                # Max battery power in runtime load-following mode (kW) for planners that emit the follow action. Default 2.0. Set to match BATTERY_MAX_CHARGE_KW for full solar surplus capture.
BATTERY_FOLLOW_BUDGET_MIN_FACTOR=0.10     # Heuristic planner: minimum load-following discharge budget as a fraction of max interval discharge when a future price peak is present.
BATTERY_FOLLOW_BUDGET_SPREAD_FACTOR=2.5    # Heuristic planner: how aggressively load-following budget shrinks below a future price peak. Set to 0 to disable spread scaling.

# Nemotron-Linprog planner (BATTERY_PLANNER_TYPE=nemotron-linprog)
# LP-based battery dispatch using scipy.optimize.linprog (HiGHS).
# All variables prefixed BATTERY_LP_ are ignored by the heuristic planner.
BATTERY_LP_HORIZON=192                      # Planning horizon (15-min intervals) when tomorrow's spot prices are known. 192 = 48 hours.
BATTERY_LP_HORIZON_FALLBACK=96              # Fallback horizon when tomorrow's spot prices aren't published yet. 96 = 24 hours.
BATTERY_LP_DISCOUNT=0.995                   # Per-interval discount applied to future costs (0.0–1.0).
BATTERY_LP_PARALLEL=0                      # HiGHS parallel solver (0=off, 1=on). Usually slower for small LPs.
BATTERY_LP_HEADROOM_COST_TOLERANCE_EUR=0.001 # Maximum objective-cost increase accepted for current-interval real-time discharge headroom.
BATTERY_TERMINAL_VALUE_PERCENTILE=0.0      # Price percentile for final SoC valuation. 0 = disabled.
BATTERY_DEGRADATION_COST_EUR_PER_KWH=0.0   # Battery wear cost per kWh cycled. 0 = disabled.
BATTERY_SOLAR_HEDGE_ALPHA=1.0              # Solar hedge blend for the LP only: solar = alpha*p50 + (1-alpha)*p10 (worst-case). 1.0 = disabled (trust central forecast). Calibration shows actual solar undercuts Solcast's p10 ~21% of the time (ideal ~10%); see notes/solar_calibration_estimate10.md. Enabling changes planning logic -> bump VERSION (MINOR).

# GSHP (Ground Source Heat Pump) settings
# At runtime GSHP_INITIAL_TEMP and GSHP_IS_RUNNING are overwritten by HA sensors
# (sensor.mlp_varaajan_lampotila and sensor.mlp_teho respectively) when available.
GSHP_OPTIMIZE_ENABLED=false                # Disable the unreliable GSHP. Set true after replacement and disable resistive optimization to restore GSHP dispatch.
GSHP_INITIAL_TEMP=50.0                     # Starting accumulator / buffer temperature (°C). Fallback when HA sensor is unavailable.
GSHP_MIN_TEMP=42.0                         # Hard minimum accumulator temperature (°C). Heat pump MUST start if temp drops to or below this.
GSHP_MAX_TEMP=55.0                         # Hard maximum accumulator temperature (°C). Heat pump MUST stop if temp reaches this.
GSHP_IS_RUNNING=false                      # Initial on/off state. Fallback when HA power sensor is unavailable.
GSHP_ELECTRIC_POWER_KW=4.0                 # Fallback nominal power. Only used when GSHP_POWER_MIN_KW and GSHP_POWER_MAX_KW are BOTH absent; in that case min and max are set to this value.
GSHP_COP=3.5                               # Coefficient of Performance (thermal output / electrical input).
GSHP_HEAT_LOSS_K=0.1                       # House heat-loss coefficient used in demand calculation: max(0, (20.0 - outside_temp) * heat_loss_k). Default in code is 0.135.
GSHP_BASELINE_DEMAND_KW=1.0                # Baseline thermal demand (kW) for DHW, circulation and standby. Added to the weather-driven heat loss.
GSHP_POWER_MIN_KW=3.4                      # Minimum electrical power when ON. The joint planner schedules either zero or a full 15-minute slot at this power or higher.
GSHP_POWER_MAX_KW=4.2                      # Maximum electrical power the compressor can draw (at max_temp). Forms a linear ramp with MIN.
GSHP_STRATEGIC_STOP_DIFF_EUR=0.05          # Spot-price difference threshold (EUR/kWh). If current effective price >= (cheapest price in lookahead window + this value), the heat pump stops strategically.

# Top-mounted resistive reservoir heater
RESISTIVE_HEATER_OPTIMIZE_ENABLED=true     # Co-optimize the resistive heater independently; it may run together with the GSHP.
RESISTIVE_HEATER_ENTITY=switch.mlp_vastus_output_0
RESISTIVE_HEATER_POWER_KW=6.0              # Fixed electrical and thermal output while switched on.
RESISTIVE_HEATER_EFFICIENCY=1.0
RESISTIVE_HEATER_EFFECTIVE_LITERS=150      # Effective top portion heated by the element; decay still uses GSHP_RESERVOIR_LITERS.
RESISTIVE_HEATER_MAX_TEMP=60.0             # Maximum planned and software-controlled reservoir temperature.

BULK_HEATER_OPTIMIZE_ENABLED=false          # Lower element, may run together with the upper element.
BULK_HEATER_ENTITY=switch.mlp_vastus_output_1
BULK_HEATER_POWER_KW=6.0
BULK_HEATER_EFFICIENCY=1.0
BULK_HEATER_MAX_TEMP=60.0

GSHP_FAILURE_MIN_PLANNED_KW=1.0
GSHP_FAILURE_MIN_COMPRESSOR_KW=1.0
GSHP_FAILURE_REQUIRED_BAD_SAMPLES=9          # 3-minute startup grace period at run_often.py's 20-second cadence.
GSHP_RECOVERY_REQUIRED_GOOD_SAMPLES=2
GSHP_FAILURE_TARGET_TEMP_MARGIN_C=2.0        # Treat a start without draw within this many degrees below GSHP_MAX_TEMP as a thermostat stop.

# EV charging settings
# The optimizer prefers to use the real-time EV SoC from sensor.xpz_491_battery_level.
# These values are used as fallbacks / targets when that sensor is unavailable or already at target.
EV_TARGET_SOC_PCT=80.0                     # Desired final State of Charge after charging (%).
EV_CAPACITY_KWH=60.0                       # EV battery capacity (kWh).
EV_CHARGE_POWER_KW=7.0                     # Charger power level (kW).
EV_CHARGE_HOURS=4.0                        # Fallback continuous charging duration (hours) used only when the current EV SoC is unknown.

# Leaf charger direct control
LEAF_CHARGING_ENTITY=switch.tasmota_3       # Directly controlled Leaf charger switch.
LEAF_MANUAL_CHARGING_ENTITY=input_boolean.leaf_manuaalinen_lataus  # Preserve manual charging when the plan requests OFF.

# Model selection
# MODEL_WEIGHT_SARIMA=1.0                   # Weight for SARIMA vs XGBoost blend (0.0 = XGBoost only, 1.0 = SARIMA only). Default 1.0.

# Solar data configuration
SOLAR_PRODUCTION_ENTITY=sensor.solarh_63038_real_power_kw  # HA entity ID for real-time solar production (kW). Change if your solar sensor has a different name.
SOLAR_FALLBACK_TO_FORECAST=true            # When true, use Solcast solar forecast as substitute for solar_actual when the real-time solar production sensor (configured via SOLAR_PRODUCTION_ENTITY) is unavailable or offline. Affects run_often.py (real-time control), predict_future.py (baseload lag features), and process_data.py (training data).

# Planning configuration
PLAN_INTERVAL_MINUTES=15                   # Time granularity of the optimization horizon in minutes. Affects battery, GSHP and EV slot calculations.

# Low cost signal configuration
# The percentile used to determine the 'low cost' threshold for the effective cost signal.
# For example, 30.0 means the cheapest 30% of intervals are considered low cost.
LOW_COST_PERCENTILE=30.0                   # Percentile (0-100) for the low cost signal threshold.
